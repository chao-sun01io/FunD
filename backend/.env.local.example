# Local hybrid dev environment.
# Django runs in its own terminal; Celery worker + Beat run via honcho.
# Only Redis runs in Docker. Database defaults to SQLite — no Postgres container required.
#
# Setup:
#   1. cp backend/.env.local.example backend/.env
#   2. Fill in DJANGO_SECRET_KEY
#   3. docker-compose -f docker-compose.infra.yml up -d
#   4. cd backend && uv run python manage.py migrate
#   5. Terminal A: uv run python manage.py runserver
#   6. Terminal B: uv run honcho start    # runs worker + beat together

# Redis — mapped to localhost via docker-compose.infra.yml
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB_CELERY_BROKER=0
REDIS_DB_INFO_APP_STORAGE=1

CELERY_BROKER_URL=redis://localhost:6380/0

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# SQLite by default for hybrid dev. Flip to True only if you run your own Postgres locally.
USE_POSTGRES=False

# PostgreSQL — only used when USE_POSTGRES=True. Leave defaults if unused.
POSTGRES_DB=my_fund_db
POSTGRES_USER=my_fund_user
POSTGRES_PASSWORD=a_very_strong_password
POSTGRES_DB_HOST=localhost
POSTGRES_DB_PORT=5432
